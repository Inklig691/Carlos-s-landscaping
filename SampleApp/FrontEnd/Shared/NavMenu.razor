@inherits LocalizedComponentBase

<nav class="site-nav" aria-label="@(Language.IsEnglish ? "Main navigation" : "Navegación principal")">
    <NavLink class="site-nav__link" href="/" Match="NavLinkMatch.All">
        <span class="oi oi-home" aria-hidden="true"></span>
        @(Language.IsEnglish ? "Home" : "Inicio")
    </NavLink>
    <NavLink class="site-nav__link site-nav__booking" href="/appointments/new">
        <span class="oi oi-calendar" aria-hidden="true"></span>
        @(Language.IsEnglish ? "Request an appointment" : "Solicitar cita")
    </NavLink>
    <NavLink class="site-nav__link" href="/reviews">
        <span class="oi oi-star" aria-hidden="true"></span>
        @(Language.IsEnglish ? "Reviews" : "Reseñas")
    </NavLink>
</nav>
