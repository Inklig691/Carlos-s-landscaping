@inherits LocalizedComponentBase

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>@(Language.IsEnglish ? "Not found" : "No encontrado")</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <section class="empty-state" role="alert">
                <span class="empty-state__icon oi oi-warning" aria-hidden="true"></span>
                <h1>@(Language.IsEnglish ? "Page not found" : "Página no encontrada")</h1>
                <p>@(Language.IsEnglish ? "Sorry, there's nothing at this address." : "Lo sentimos, no hay contenido en esta dirección.")</p>
                <a class="btn btn-primary" href="/">@(Language.IsEnglish ? "Return home" : "Volver al inicio")</a>
            </section>
        </LayoutView>
    </NotFound>
</Router>
